extends SceneTree

const ProtoBridge = preload("res://scripts/net/proto_bridge.gd")


func _init() -> void:
	_test_login_request()
	_test_login_response()
	_test_move_messages()
	_test_world_notifications()
	print("ProtoBridge tests passed")
	quit()


func _test_login_request() -> void:
	assert(ProtoBridge.encode_login_req("player_a") == PackedByteArray([0x0A, 0x08, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x5F, 0x61]))


func _test_login_response() -> void:
	var response := ProtoBridge.decode_login_res(PackedByteArray([
		0x08, 0x01, 0x12, 0x0A, 0x0A, 0x08, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x5F, 0x61,
	]))
	assert(response["success"])
	assert(response["player_id"] == "player_a")


func _test_move_messages() -> void:
	var request := ProtoBridge.encode_move_req(Vector3(1.5, -2.0, 3.25), 90.0)
	assert(request == PackedByteArray([
		0x0A, 0x0F, 0x0D, 0x00, 0x00, 0xC0, 0x3F, 0x15, 0x00, 0x00, 0x00, 0xC0, 0x1D, 0x00, 0x00, 0x50, 0x40,
		0x15, 0x00, 0x00, 0xB4, 0x42,
	]))

	var response := ProtoBridge.decode_move_res(PackedByteArray([
		0x08, 0x00, 0x12, 0x08, 0x74, 0x6F, 0x6F, 0x20, 0x66, 0x61, 0x73, 0x74, 0x1A, 0x0F,
		0x0D, 0x00, 0x00, 0x80, 0x3F, 0x15, 0x00, 0x00, 0x00, 0x40, 0x1D, 0x00, 0x00, 0x40, 0x40,
	]))
	assert(not response["success"])
	assert(response["error_msg"] == "too fast")
	assert(response["corrected"] == Vector3(1.0, 2.0, 3.0))


func _test_world_notifications() -> void:
	var player := ProtoBridge.decode_player_transform(PackedByteArray([
		0x0A, 0x08, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x5F, 0x61, 0x12, 0x05, 0x41, 0x6C, 0x69, 0x63, 0x65,
		0x1A, 0x0F, 0x0D, 0x00, 0x00, 0x80, 0x3F, 0x15, 0x00, 0x00, 0x00, 0x40, 0x1D, 0x00, 0x00, 0x40, 0x40,
		0x25, 0x00, 0x00, 0x34, 0x42,
	]))
	assert(player["player_id"] == "player_a")
	assert(player["player_name"] == "Alice")
	assert(player["position"] == Vector3(1.0, 2.0, 3.0))
	assert(player["yaw"] == 45.0)

	var state := ProtoBridge.decode_world_state(PackedByteArray([
		0x0A, 0x1B, 0x0A, 0x08, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x5F, 0x61, 0x1A, 0x0F,
		0x0D, 0x00, 0x00, 0x80, 0x3F, 0x15, 0x00, 0x00, 0x00, 0x40, 0x1D, 0x00, 0x00, 0x40, 0x40,
	]))
	assert(state.size() == 1)
	assert(state[0]["player_id"] == "player_a")
	assert(ProtoBridge.decode_world_player_leave(PackedByteArray([0x0A, 0x08, 0x70, 0x6C, 0x61, 0x79, 0x65, 0x72, 0x5F, 0x61])) == "player_a")
